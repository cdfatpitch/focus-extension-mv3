{
    "name": "Focus \u2014 Local MV3 Adaptation",
    "author": "Brad Jasper",
    "version": "2.8.3",
    "manifest_version": 3,
    "minimum_chrome_version": "116",
    "description": "Unofficial local Manifest V3 adaptation of the Focus extension. Requires the Focus macOS app.",
    "icons": {
        "16": "icon_16.png",
        "48": "icon_48.png",
        "128": "icon_128.png"
    },
    "permissions": [
        "webNavigation",
        "tabs",
        "alarms"
    ],
    "background": {
        "service_worker": "worker.js"
    }
}
